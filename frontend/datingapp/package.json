{
  "name": "datingapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run assets && ng serve",
    "build": "npm run assets && ng build && node scripts/finalize-seo.mjs",
    "build:analyze": "npm run assets && ng build --source-map --stats-json && node scripts/finalize-seo.mjs",
    "social:image": "node scripts/generate-social-image.mjs",
    "email:type": "node scripts/generate-email-type.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "search:report": "node scripts/search-console.mjs report",
    "search:inspect": "node scripts/search-console.mjs inspect",
    "watch": "npm run assets && ng build --watch --configuration development",
    "preview": "node scripts/serve-build.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:live": "node scripts/check-live-seo.mjs",
    "check:ai": "node scripts/check-ai-crawlers.mjs",
    "test:e2e": "playwright test",
    "test": "ng test",
    "assets": "node scripts/generate-icons.mjs && node scripts/prepare-dialog-styles.mjs && node scripts/optimize-images.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "^1.63.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
