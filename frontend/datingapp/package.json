{
  "name": "datingapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-icons.mjs && ng serve",
    "build": "node scripts/generate-icons.mjs && ng build && node scripts/finalize-seo.mjs",
    "build:analyze": "node scripts/generate-icons.mjs && ng build --source-map --stats-json && node scripts/finalize-seo.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "search:report": "node scripts/search-console.mjs report",
    "search:inspect": "node scripts/search-console.mjs inspect",
    "watch": "node scripts/generate-icons.mjs && ng build --watch --configuration development",
    "preview": "node scripts/serve-build.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:live": "node scripts/check-live-seo.mjs",
    "test:e2e": "playwright test",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "22.1.6",
    "@angular/ssr": "^22.1.7",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.6",
    "@playwright/test": "^1.63.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
