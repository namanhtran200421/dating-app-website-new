NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/rosemarry

# Use Cloudflare's documented test secret locally; never use it in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Optional for local development; required in production.
RESEND_API_KEY=

CONTACT_RETENTION_DAYS=365
PRE_SIGNUP_RETENTION_DAYS=730

# Production defaults to one trusted Render proxy hop. Only override this after
# checking the live proxy chain.
# TRUSTED_PROXY_HOPS=1
